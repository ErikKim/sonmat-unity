<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet build -c Release            (packaging/build.ps1: the references come from the BepInEx NuGet feed, nuget.config)
       dotnet build -c Release -p:BepInExCore=<BepInEx\core of the BepInEx 5 x64 release> -p:UnityManaged=<any Unity game's *_Data\Managed>
                                          (the same, from files on this PC: only the base types are taken from them) -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>SonmatUnity</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- compile-time only: BepInEx and Harmony are the game's (BepInEx 5.4.23 carries HarmonyX 2.9.0), Unity's are the
       game's own. Unity 2017.4 = the oldest the plugin serves (Overcooked 2); newer Unity keeps these types -->
  <ItemGroup Condition="'$(BepInExCore)' == ''">
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.21" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="HarmonyX" Version="2.9.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2017.4.40" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(BepInExCore)' != ''">
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(UnityManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
